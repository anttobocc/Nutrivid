# Copiá este archivo como .env y completá los valores.
# Las variables definidas en el entorno del sistema tienen prioridad.

# Generá una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambiame

# true solo en desarrollo. En producción: false.
DJANGO_DEBUG=true

# Dominios separados por comas. Con DEBUG=true, si se deja vacío se usa localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Número de WhatsApp que recibe los pedidos: formato internacional, sin "+" ni espacios.
WHATSAPP_NUMBER=5493790000000
